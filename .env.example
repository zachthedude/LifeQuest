# LifeQuest configuration — copy to `.env` and edit. Never commit the real file.

# ---------------------------------------------------------------- AI layer --
# Every AI feature works with no model at all: quest generation, proof
# evaluation, difficulty adaptation and the Guide fall back to the built-in
# deterministic engine. A model only upgrades the prose and the judgement.
#
# auto     hosted key if AI_API_KEY is set, else a running Ollama, else built-in
# ollama   always the local daemon
# anthropic  always the hosted API
# none     always the built-in engine
AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_BASE_URL=https://api.anthropic.com
AI_TIMEOUT_SECONDS=45
# Set to 0 to force the local engine even when a key is present.
AI_ENABLED=1

# ------------------------------------------------------------------ ollama --
# `ollama serve` + `ollama pull qwen2.5` is all VERA needs. No key, and no data
# leaves the machine. The timeout is generous because a mid-size model on CPU
# takes its time.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------- database --
# Path to the SQLite file. Created automatically on first run.
DATABASE_URL=./data/lifequest.db

# ----------------------------------------------------------------- server ---
LIFEQUEST_HOST=127.0.0.1
LIFEQUEST_PORT=8770
LIFEQUEST_SESSION_DAYS=30
LIFEQUEST_UPLOAD_DIR=./data/uploads
LIFEQUEST_MAX_UPLOAD_BYTES=8388608
# 1 enables request logging.
LIFEQUEST_DEV=0
